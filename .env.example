# ==============================================================================
# RAG Parsing Server — Environment Configuration
# Copy this file to .env and fill in your values
# ==============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@localhost:5432/rag_db

# --- PDF Storage ---
# Local path where uploaded PDFs are stored
# Structure: {PDF_STORAGE_PATH}/{user_id}/{subject_id}/{document_id}.pdf
PDF_STORAGE_PATH=./storage/pdfs

# --- Pipeline Defaults ---
DEFAULT_PIPELINE_MODE=balanced
DEFAULT_OCR_ENGINE=easyocr

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- Kafka (external broker) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# ==============================================================================
# Phase 2 — RAG Query Service
# ==============================================================================

# --- Qdrant Vector Database ---
QDRANT_URL=http://localhost:6333

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Kafka Topics ---
KAFKA_QUESTION_TOPIC=question-requests
KAFKA_RESPONSE_TOPIC=question-responses
KAFKA_ERROR_TOPIC=question-errors

# --- Search ---
TOP_K_RESULTS=8
SIMILARITY_THRESHOLD=0.55
